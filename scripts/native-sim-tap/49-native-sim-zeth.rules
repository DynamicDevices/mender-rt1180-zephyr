/* Allow the TAP owner to start/stop/restart native-sim-zeth.service without sudo. */
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.systemd1.manage-units") !== 0) {
        return;
    }
    var unit = action.lookup("unit");
    if (unit !== "native-sim-zeth.service") {
        return;
    }
    if (subject.user === "__ZETH_USER__") {
        return polkit.Result.YES;
    }
});
