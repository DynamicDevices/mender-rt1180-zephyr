/*
 * Custom-board dual-FlexSPI map (provisional — pinmux TBD with hardware).
 *
 * FlexSPI1: XIP / MCUboot / slot0 / slot1 / small NVS
 * FlexSPI2: OTA staging (raw) + e-ink LittleFS gallery
 *
 * Part numbers and sizes are placeholders until Michael confirms BOM.
 */
/ {
	fstab {
		compatible = "zephyr,fstab";
		lfs1: lfs1 {
			compatible = "zephyr,fstab-littlefs";
			mount-point = "/lfs1";
			partition = <&eink_storage>;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
			automount;
		};
	};
};

