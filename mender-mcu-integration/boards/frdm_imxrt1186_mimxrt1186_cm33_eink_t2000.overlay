/*
 * FRDM-IMXRT1186 — USB host for T2000 vendor-bulk TCON (25" Spectra 6).
 *
 * Adds nxp,uhc-ehci at the same EHCI0 regs as usb1 (device node stays off).
 * Build: FRDM_T2000=1 ./scripts/build-rt1186-frdm-eink.sh
 * Doc:   docs/FRDM-T2000-USB-HOST.md
 */

&peripheral {
	zephyr_uhc0: usbh1: usbh@2c80000 {
		compatible = "nxp,uhc-ehci";
		reg = <0x2c80000 0x1000>;
		interrupts = <215 0>;
		interrupt-names = "usb_otg";
		clocks = <&usbclk>;
		status = "okay";
		phy-handle = <&usbphy1>;
	};
};

&usbphy1 {
	status = "okay";
	tx-d-cal = <7>;
	tx-cal-45-dp-ohms = <6>;
	tx-cal-45-dm-ohms = <6>;
};

/* Keep on-chip UDC nodes disabled — host-only on this controller. */
&usb1 {
	status = "disabled";
};

&usb2 {
	status = "disabled";
};
